NODE_ENV=development
# Use a dedicated PostgreSQL database. Replace the connection string locally.
DATABASE_URL=postgresql://app_user:replace-locally@127.0.0.1:5432/flood_relief
HOST=127.0.0.1
PORT=3000
CORS_ORIGINS=http://localhost:8080
MEDIA_DIRECTORY=.local/media
SESSION_HOURS=12
# Resource limits for this deployment; these are not numbers prescribed by the backlog.
MAX_IMAGE_BYTES=8388608
MAX_IMAGE_PIXELS=20000000
MAX_EVIDENCE_LINKS=20
LOGIN_ATTEMPTS_PER_MINUTE=10
# Production: STORAGE_BACKEND=s3 and S3_BUCKET/AWS_REGION, or explicitly provision
# a persistent local volume and set MEDIA_PERSISTENT_VOLUME=true.
