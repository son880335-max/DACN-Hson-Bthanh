{
  "name": "flood-relief-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Sprint 2 API with PostgreSQL, authorization and durable idempotency",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/src/main.js",
    "migrate": "tsx scripts/migrate.ts",
    "seed:dev": "tsx scripts/seed-dev.ts",
    "seed:week2": "tsx scripts/seed-week2.ts",
    "test": "npm run build && node --test --test-concurrency=1 dist/test/*.test.js",
    "check": "npm run build && npm test",
    "demo": "tsx scripts/demo.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1164.0",
    "@fastify/cors": "11.4.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "10.1.8",
    "@fastify/rate-limit": "11.2.2",
    "@nestjs/common": "12.4.0",
    "@nestjs/core": "12.4.0",
    "@nestjs/platform-fastify": "12.4.0",
    "@node-rs/argon2": "2.2.2",
    "dotenv": "18.0.9",
    "libphonenumber-js": "1.13.15",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "embedded-postgres": "18.6.0-beta.19",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "type": "module"
}
