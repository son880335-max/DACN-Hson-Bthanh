# ==========================================
# Chỉ theo dõi Frontend và Backend, bỏ qua các thư mục khác ở root
# ==========================================
/_helpers/
/inputs/
/work/
*.doc
*.docx
*.pdf

# File hệ điều hành & Editor
.DS_Store
Thumbs.db
*.log
.vscode/
.idea/

# ==========================================
# Flutter / Dart (Frontend)
# ==========================================
Frontend/.dart_tool/
Frontend/build/
Frontend/.flutter-plugins
Frontend/.flutter-plugins-dependencies
Frontend/.packages
Frontend/*.iml
Frontend/.idea/

# ==========================================
# Backend (Dành cho Node.js / Python / Java nếu có sau này)
# ==========================================
Backend/node_modules/
Backend/dist/
Backend/build/
Backend/.env
Backend/__pycache__/
Backend/*.pyc
Backend/venv/
Backend/target/
